# Slack Error Reporting
# Get your webhook URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# YouTube Cookies (for age-restricted videos)
# 1. Log into YouTube in your browser
# 2. Use "Get cookies.txt LOCALLY" browser extension to export cookies for youtube.com
# 3. Save the exported file as cookies.txt in the project root
# The file will be mounted read-only into the container automatically.
